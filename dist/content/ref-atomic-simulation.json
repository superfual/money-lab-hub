    "source": "pragma solidity 0.8.30; interface ICPU {function tapeout(bytes calldata,uint32,uint32) external payable returns(uint256);function eval(uint256,bytes calldata) external view returns(bytes memory);function circuitInfo(uint256) external view returns(uint32,uint32,uint32,uint32);function netlist(uint256) external view returns(bytes memory);}contract RefSimulation {function check(address cpu,bytes calldata design) external payable returns(uint256 id,bytes memory outputs,uint32[4] memory shape){id=ICPU(cpu).tapeout{value:msg.value}(design,3,1);(shape[0],shape[1],shape[2],shape[3])=ICPU(cpu).circuitInfo(id);require(keccak256(ICPU(cpu).netlist(id))==keccak256(design),'NETLIST_MISMATCH');outputs=new bytes(8);for(uint8 n=0;n<8;n++){bytes memory out=ICPU(cpu).eval(id,abi.encodePacked(n));require(out.length==1,'OUTPUT_SIZE');outputs[n]=out[0];}}}",
